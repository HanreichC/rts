shader_type spatial;

render_mode cull_disabled;

uniform vec4 water_color : source_color = vec4(0.0, 0.23, 0.78, 1.0);
uniform float wave_height : hint_range(0.0, 1.0, 0.01) = 0.22;
uniform float wave_speed : hint_range(0.0, 3.0, 0.01) = 0.85;
uniform float wave_density : hint_range(0.1, 4.0, 0.01) = 1.65;
uniform float metallic : hint_range(0.0, 1.0, 0.01) = 0.15;
uniform float roughness : hint_range(0.0, 1.0, 0.01) = 0.34;

float random_wave(vec2 position, float time, vec2 direction, float frequency, float speed) {
	return sin(dot(position, direction) * frequency + time * speed);
}

float water_height(vec2 position, float time) {
	float wave_a = random_wave(position, time, normalize(vec2(0.88, 0.47)), wave_density * 2.2, wave_speed);
	float wave_b = random_wave(position, time, normalize(vec2(-0.35, 0.94)), wave_density * 1.6, wave_speed * 0.67);
	float wave_c = random_wave(position, time, normalize(vec2(0.61, -0.79)), wave_density * 3.1, wave_speed * 1.31);
	float wave_d = random_wave(position, time, normalize(vec2(-0.97, -0.24)), wave_density * 0.9, wave_speed * 0.42);
	return wave_a * 0.42 + wave_b * 0.27 + wave_c * 0.19 + wave_d * 0.12;
}

void vertex() {
	float height = water_height(VERTEX.xz, TIME);
	VERTEX.y += height * wave_height;
}

void fragment() {
	// Derivatives are constant across each rasterized triangle, yielding flat low-poly lighting.
	NORMAL = normalize(cross(dFdx(VERTEX), dFdy(VERTEX)));
	ALBEDO = water_color.rgb;
	METALLIC = metallic;
	SPECULAR = 0.85;
	ROUGHNESS = roughness;
}
